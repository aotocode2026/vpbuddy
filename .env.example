# VPBuddy 环境变量模板
# 复制为 .env 或 .hermes/.env 然后填实际值
# 注意: .env 不入 git(.gitignore 已忽略)

# ===== 必需的 AI Provider 配置 =====
# 百炼: 实时 ASR + 图片识别
DASHSCOPE_API_KEY=
# 可省略；Docker Compose 默认复用 DASHSCOPE_API_KEY
BAILIAN_API_KEY=

# MiniMax: VP Chat + 5 文档 + Demo
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MODEL=minimax-m3

# ===== 飞书(Lark)凭证 =====
# ⚠️ **Superseded by ADR-0008 (2026-06-21)** — VPBuddy 数据源改为 VP 桌面客户端麦克风/系统音频 (ADR-0004)
# 不再依赖飞书妙记/SDK,以下变量保留只为兼容老代码(实际不读取)

# FEISHU_APP_ID=cli_xxxxxxxxxxxx    # ADR-0008 Superseded — 不再使用
# FEISHU_APP_SECRET=xxxxxx...xxxx   # ADR-0008 Superseded — 不再使用
# FEISHU_DOMAIN=feishu              # ADR-0008 Superseded — 不再使用
# FEISHU_MODE=websocket             # ADR-0008 Superseded — 不再使用

# ===== VPBuddy 路径(可选,有默认值) =====
# VPBUDDY_DATA_DIR=/home/zsd/vpbuddy/data/meetings
# VPBUDDY_DOCS_DIR=/home/zsd/vpbuddy/docs
# VPBUDDY_POLL_INTERVAL=30
# VPBUDDY_JWT_SECRET=请使用密码管理器生成并长期保存的随机密钥
# 可选：裸机部署时显式指定 fallback env 文件；进程环境变量始终优先
# VPBUDDY_ENV_FILE=/data/vpbuddy/.env

# ===== UI 服务端口 =====
# VPBUDDY_UI_PORT=8765

# ===== 平台 token(企微/钉钉,可选) =====
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_SECRET=
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=

# ===== GPU 推理(192.168.10.63) =====
# HF_HUB_OFFLINE=1
# PYANNOTE_LOCAL_DIR=/home/zsd/pyannote_models
