# VPBuddy 环境变量模板
# 复制为 .env 或 .hermes/.env 然后填实际值
# 注意: .env 不入 git(.gitignore 已忽略)

# ===== 飞书(Lark)凭证 =====
# ⚠️ **Superseded by ADR-0008 (2026-06-21)** — VPBuddy 数据源改为 VP 桌面客户端麦克风/系统音频 (ADR-0004)
# 不再依赖飞书妙记/SDK,以下变量保留只为兼容老代码(实际不读取)

# FEISHU_APP_ID=cli_xxxxxxxxxxxx    # ADR-0008 Superseded — 不再使用
# FEISHU_APP_SECRET=xxxxxx...xxxx   # ADR-0008 Superseded — 不再使用
# FEISHU_DOMAIN=feishu              # ADR-0008 Superseded — 不再使用
# FEISHU_MODE=websocket             # ADR-0008 Superseded — 不再使用

# ===== VPBuddy 持久化路径 =====
# 服务端部署时必须使用 /data 下的绝对路径；6docs 固定为 DATA_DIR/docs。
# VPBUDDY_DATA_DIR=/data/vpbuddy/data
# VPBUDDY_DOCS_DIR=/data/vpbuddy/data/docs
# VPBUDDY_KB_DIR=/data/vpbuddy/kb
# VPBUDDY_POLL_INTERVAL=30

# ===== UI 服务端口 =====
# VPBUDDY_UI_PORT=8765

# ===== 平台 token(企微/钉钉,可选) =====
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_SECRET=
# DINGTALK_APP_KEY=
# DINGTALK_APP_SECRET=

# ===== GPU 推理(192.168.10.63) =====
# HF_HUB_OFFLINE=1
# PYANNOTE_LOCAL_DIR=/home/zsd/pyannote_models
